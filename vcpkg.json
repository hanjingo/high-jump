{
  "dependencies": [
    "abseil",
    {
      "name": "behaviortree-cpp",
      "default-features": false
    },
    "benchmark",
    "bext-sml",
    "boost-algorithm",
    "boost-asio",
    "boost-beast",
    "boost-circular-buffer",
    "boost-coroutine2",
    "boost-filesystem",
    "boost-interprocess",
    "boost-leaf",
    "boost-math",
    "boost-multi-index",
    "boost-process",
    "boost-program-options",
    "boost-property-tree",
    "boost-stacktrace",
    "boost-thread",
    "boost-uuid",
    "breakpad",
    "clickhouse-cpp",
    "concurrentqueue",
    {
      "name": "cpp-httplib",
      "features": ["openssl"]
    },
    {
      "name": "eigen3",
      "default-features": false
    },
    "faiss",
    "flatbuffers",
    "fmt",
    {
      "name": "ggml",
      "default-features": false
    },
    "grpc",
    "gtest",
    "hffix",
    "hidapi",
    "highway",
    "hiredis",
    "jwt-cpp",
    "llama-cpp",
    "libharu",
    "libiconv",
    "libnice",
    "libqrencode",
    "nlohmann-json",
    "opencl",
    {
      "name": "openssl",
      "default-features": false
    },
    {
      "name": "opentelemetry-cpp",
      "features": [ "otlp-http", "otlp-file" ]
    },
    {
      "name": "protobuf",
      "default-features": false
    },
    "pugixml",
    "quirc",
    "spdlog",
    {
      "name": "sqlite3",
      "default-features": false
    },
    {
      "name": "tbb",
      "default-features": false
    },
    "tesseract",
    {
      "name": "whisper-cpp",
      "default-features": false
    },
    "yaml-cpp",
    {
      "name": "zeromq",
      "default-features": false
    },
    "zlib",
    "zstd"
  ],
  "features": {
    "cuda": {
      "description": "Enable CUDA support for GGML, Whisper",
      "dependencies": [
        {
          "name": "ggml",
          "features": ["cuda"]
        },
        {
          "name": "whisper-cpp",
          "features": ["cuda"]
        }
      ]
    },
    "https": {
      "description": "Enable HTTPS support for cpp-httplib",
      "dependencies": [
        {
          "name": "cpp-httplib",
          "features": ["openssl"]
        }
      ]
    }
  }
}